<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="business_pulse_target_view_list" model="ir.ui.view">
        <field name="name">business.pulse.target.list</field>
        <field name="model">business.pulse.target</field>
        <field name="arch" type="xml">
            <list string="Targets">
                <field name="name"/>
                <field name="metric"/>
                <field name="scope"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="business_pulse_target_view_form" model="ir.ui.view">
        <field name="name">business.pulse.target.form</field>
        <field name="model">business.pulse.target</field>
        <field name="arch" type="xml">
            <form string="Target">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Q4 sales target"/></h1>
                    </div>
                    <group>
                        <group string="What">
                            <field name="metric"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="metric == 'order_count'" readonly="1"/>
                        </group>
                        <group string="Who">
                            <field name="scope" widget="radio"/>
                            <field name="team_id" invisible="scope != 'team'" required="scope == 'team'"/>
                            <field name="user_id" invisible="scope != 'user'" required="scope == 'user'"
                                   widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="When">
                            <field name="period"/>
                            <field name="date_from"/>
                            <field name="date_to" readonly="period != 'custom'" force_save="1"/>
                        </group>
                    </group>
                    <div class="text-muted small">
                        Progress uses the same definition, company currency and dates as the matching dashboard KPI,
                        measured from the start date up to today (or the end date once it has passed).
                    </div>
                    <field name="note" placeholder="Internal notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="business_pulse_target_view_search" model="ir.ui.view">
        <field name="name">business.pulse.target.search</field>
        <field name="model">business.pulse.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <filter name="current" string="Current"
                        domain="[('date_from', '&lt;=', context_today().strftime('%Y-%m-%d')), ('date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_metric" string="Metric" context="{'group_by': 'metric'}"/>
                    <filter name="group_scope" string="Applies to" context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_business_pulse_targets" model="ir.actions.act_window">
        <field name="name">Targets</field>
        <field name="res_model">business.pulse.target</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set your first target</p>
            <p>Targets track confirmed sales, orders or invoiced revenue for the company, a sales team or a
               salesperson over a month, quarter, year or custom period.</p>
        </field>
    </record>
</odoo>
