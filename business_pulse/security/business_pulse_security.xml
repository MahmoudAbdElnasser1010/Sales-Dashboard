<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_business_pulse" model="ir.module.category">
        <field name="name">Business Pulse</field>
        <field name="description">Access to the Business Pulse executive dashboard.</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_business_pulse_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_business_pulse"/>
        <field name="comment">Can open the Business Pulse dashboard. Figures still follow the user's own access rights: financial sections additionally require an Invoicing/Accounting role.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Sales managers get the dashboard out of the box. -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_business_pulse_user'))]"/>
    </record>

    <record id="rule_business_pulse_preference_own" model="ir.rule">
        <field name="name">Business Pulse: own preferences only</field>
        <field name="model_id" ref="model_business_pulse_preference"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_business_pulse_user'))]"/>
    </record>

    <record id="rule_business_pulse_view_own" model="ir.rule">
        <field name="name">Business Pulse: own saved views only</field>
        <field name="model_id" ref="model_business_pulse_view"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_business_pulse_user'))]"/>
    </record>

    <record id="rule_business_pulse_target_company" model="ir.rule">
        <field name="name">Business Pulse: targets of allowed companies</field>
        <field name="model_id" ref="model_business_pulse_target"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Salespeople limited to their own documents only see company/team
         targets and their own personal targets. -->
    <record id="rule_business_pulse_target_own_salesman" model="ir.rule">
        <field name="name">Business Pulse: personal targets (own documents)</field>
        <field name="model_id" ref="model_business_pulse_target"/>
        <field name="domain_force">['|', ('scope', '!=', 'user'), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_business_pulse_target_all_salesman" model="ir.rule">
        <field name="name">Business Pulse: all targets (all documents)</field>
        <field name="model_id" ref="model_business_pulse_target"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
</odoo>
